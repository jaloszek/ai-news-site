    {
      "title": "In-Context Learning",
      "url": "https://bdtechtalks.com/2025/09/25/llm-in-context-learning-study-microsoft/",
      "summary": "Language models solved this friction for text via (ICL). You drop a document into the prompt and get answers immediately. Developers naturally want to drop a CSV or SQL table into an LLM to bypass the traditional ML lifecycle entirely.",
      "published_at": "2026-07-26T14:32:06Z",
